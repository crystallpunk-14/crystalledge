<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\bin\Content.Redactor\</OutputPath>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="9.0.1" />
  </ItemGroup>

  <!-- Ensure Content.Server/Client build first so assemblies exist for scanning -->
  <ItemGroup>
    <ProjectReference Include="..\Content.Server\Content.Server.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Content.Client\Content.Client.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Extract prototype metadata after build -->
  <Target Name="ExtractPrototypeMetadata" AfterTargets="Build">
    <Exec Command="dotnet &quot;$(OutputPath)Content.Redactor.dll&quot; extract &quot;$(MSBuildProjectDirectory)\..&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)\.."
          IgnoreExitCode="true" />
  </Target>
</Project>
