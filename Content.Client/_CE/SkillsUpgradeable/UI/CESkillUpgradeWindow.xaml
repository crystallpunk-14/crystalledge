<ce:CESkillUpgradeWindow
    xmlns="https://spacestation14.io"
    xmlns:ce="clr-namespace:Content.Client._CE.SkillsUpgradeable.UI"
    Title="{Loc 'ce-skill-upgrade-window-title'}"
    MinSize="420 300"
    MaxSize="420 600">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
        <Label Text="{Loc 'ce-skill-upgrade-window-header'}" StyleClasses="LabelHeadingBigger"
               HorizontalAlignment="Center" Margin="0,4,0,8" />
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False" Margin="4">
            <BoxContainer Orientation="Vertical" Name="SkillsList" SeparationOverride="6" />
        </ScrollContainer>
    </BoxContainer>
</ce:CESkillUpgradeWindow>
